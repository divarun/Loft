# ── AI Provider ───────────────────────────────────────────────────────────────
# Priority: NVIDIA NIM → Anthropic → none (exact-match fallback, no generation)
#
# Set exactly ONE of these. If neither is set, IdeaBridge still works — typed
# answers require exact matches and the AI-Generated puzzle mode is disabled.

# Option 1 — NVIDIA NIM (default, recommended)
NVIDIA_NIM_API_KEY=nvapi-...
# Optional: override the NIM model (default: meta/llama-3.1-70b-instruct)
# NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Option 2 — Anthropic / Claude
# ANTHROPIC_API_KEY=sk-ant-...

# ── Vercel KV ─────────────────────────────────────────────────────────────────
# Required for: AtlasRush global daily stats, LetterDrop leaderboard
# Get these from the Vercel dashboard after linking a KV store to the project.
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
